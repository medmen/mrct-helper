{
	"description": "MRCT-helper - Browser Extension to help prefill mrct-registry.org with standard values",
	"manifest_version": 3,
	"name": "MRCT-helper",
	"version":"1.5",
	"license": "MIT",

	"icons": {
		"48": "icons/mrct-helper-48.png"
	},

	"content_scripts": [
		{
			"matches": ["*://registry.mrct-registry.org/*"],
			"js": ["presets.js", "form-controls.js", "mrct-helper.js"]
		}
	],

	"browser_specific_settings": {
		"gecko": {
			"id": "mrct-helper@humanvisualisierungsknecht.de"
		}
	},

	"host_permissions": [
		"*://registry.mrct-registry.org/*"
	],

	"permissions": [
		"tabs",
		"scripting",
		"activeTab"
	],

	"action": {
		"default_icon": "icons/mrct-helper-48.png",
		"default_title": "MRCT-Helper",
		"default_popup": "popup/mrct-helper_popup.html"
	}
}
